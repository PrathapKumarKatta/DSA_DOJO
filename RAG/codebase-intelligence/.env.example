# Application Configuration
APP_NAME="Codebase Intelligence"
APP_ENV=development
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="temporary-secret-key-change-in-production-must-be-at-least-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=charan
POSTGRES_PASSWORD=
POSTGRES_DB=codebase_intelligence
DATABASE_URL=postgresql+psycopg://charan:@localhost:5432/codebase_intelligence

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Storage & Upload Limits
STORAGE_DIR="./storage"
MAX_UPLOAD_SIZE_MB=50
MAX_EXTRACTED_SIZE_MB=150
MAX_PROJECT_FILES=2000
MAX_SINGLE_FILE_SIZE_KB=1024

# RAG & Embedding Settings
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
RERANKING_ENABLED=false
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# LLM Configuration
LLM_PROVIDER=mock
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
LLM_BASE_URL=

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
