  "cards": [
    {
      "dot": "cyan",
      "title": "Scheduling",
      "items": [
        "Beat queues a scan; a worker executes that scan.",
        "The scanner finds unfinished tasks due within one hour or already overdue.",
        "Recipient is the assignee, falling back to the creator."
      ]
    },
    {
      "dot": "emerald",
      "title": "Durable intent",
      "items": [
        "PostgreSQL records each task/recipient/due occurrence.",
        "Expired five-minute queue leases allow dispatch recovery.",
        "A delivery reloads current data and can cancel an obsolete reminder."
      ]
    },
    {
      "dot": "rose",
      "title": "Delivery limits",
      "items": [
        "Transient errors back off; at most five recorded send attempts.",
        "Console delivery logs an ID; it does not send to an inbox.",
        "SMTP success before a process crash can still cause a duplicate retry."
      ]
    }
  ]
