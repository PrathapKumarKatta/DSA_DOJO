# Copy to BACKEND/.env.production ON THE SERVER and replace the placeholders.
# Generate separate URL-safe random strings for all three secrets.
DOMAIN=tasks.your-real-domain.example
TLS_EMAIL=your-contact-address@example.com
POSTGRES_PASSWORD=GENERATE_A_UNIQUE_URL_SAFE_PASSWORD
REDIS_PASSWORD=GENERATE_ANOTHER_UNIQUE_URL_SAFE_PASSWORD
JWT_SECRET=GENERATE_A_SEPARATE_LONG_RANDOM_JWT_SECRET
APP_IMAGE=taskflow-api:portfolio-v1
WEB_IMAGE=taskflow-web:portfolio-v1
EMAIL_BACKEND=console
EMAIL_FROM=taskflow@example.com
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
